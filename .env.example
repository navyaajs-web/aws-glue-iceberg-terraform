# Copy to .env (git-ignored) only if you deploy examples/dev yourself.
# Nothing in CI or the tests reads these; they are for the optional deploy.
# Never put access keys here: prefer `aws sso login` and a named profile.

AWS_PROFILE=your-sso-profile
AWS_REGION=eu-west-1

# Terraform input variables (TF_VAR_<name>) for examples/dev
TF_VAR_bucket_suffix=replace-with-random
TF_VAR_alert_email_addresses=["you@example.com"]
